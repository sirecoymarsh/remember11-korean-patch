y":"mac.afs::0134::0141","target_ko":"유니에게서 『내 몸』을 떼어 내려는 모양이었다.%K%N"},{"key":"mac.afs::0134::0142","target_ko":"『내 몸』이 돌아서서 호토리를 후려쳤다.%K%N"},{"key":"mac.afs::0134::0143","target_ko":"입을 크게 벌린 건 포효라도 지르고 있기 때문인가……?%K%P"},{"key":"mac.afs::0134::0144","target_ko":"그렇게 차마 눈 뜨고 볼 수 없는 만행이 펼쳐졌다.%K%N"},{"key":"mac.afs::0134::0145","target_ko":"『내 몸』이 소파를 찢었다.%K%N"},{"key":"mac.afs::0134::0146","target_ko":"탁자 위의 재떨이를 집어 들고 아무 방향으로나 집어던졌다.%K%N"},{"key":"mac.afs::0134::0147","target_ko":"플라스마 디스플레이에 정통으로 맞았다. 파편이 요란하게 튀었다.%K%P"},{"key":"mac.afs::0134::0148","target_ko":"의자를 휘두르고 탁자를 걷어차고 컴퓨터 모니터를 움켜쥐어 배선을 뜯어냈다.%K%N"},{"key":"mac.afs::0134::0149","target_ko":"그 모니터를 든 채 칸막이 유리를 모조리 박살 냈다.%K%N"},{"key":"mac.afs::0134::0150","target_ko":"차마 볼 수 없는 영상이 이어졌다…….%K%N"},{"key":"mac.afs::0134::0151","target_ko":"『내 몸』은 격렬하게 흥분해 짐승처럼 날뛰고 있었다.%K%P"},{"key":"mac.afs::0134::0152","target_ko":"사토루「이게……」%K%P"},{"key":"mac.afs::0134::0153","target_ko":"사토루「후유카와 코코로의…… 정체……」%K%P"},{"key":"mac.afs::0134::0154","target_ko":"화면에는 공황에 빠져 허둥대며 도망치는 호토리와 유니의 모습이 비쳤다.%K%P"},{"key":"mac.afs::0134::0155","target_ko":"두 사람은 서로 손을 잡고 유니의 방으로 굴러들어 가듯 뛰어들었다.%K%P"},{"key":"mac.afs::0134::0156","target_ko":"『내 몸』은 그런 일에는 아랑곳하지 않고 여전히 착란 상태로 날뛰었다.%K%P"},{"key":"mac.afs::0134::0157","target_ko":"『내 몸』은 자신이 그곳에 존재한다는 사실을 과시하는 듯했다.%K%P"},{"key":"mac.afs::0134::0158","target_ko":"『내 몸』은 서투르게 자신을 주장하는 듯했다.%K%P"},{"key":"mac.afs::0134::0159","target_ko":"『내 몸』은 이 세계를 사랑하면서 동시에 증오하고 있었다.%K%P"},{"key":"mac.afs::0134::0160","target_ko":"『내 몸』은 세계와 희롱하고 있었다.%K%P"},{"key":"mac.afs::0134::0161","target_ko":"『내 몸』은 큰 소리를 질렀다. 그리고 울었다.%K%P"},{"key":"mac.afs::0134::0162","target_ko":"『내 몸』은 무엇이든, 이 세상의 모든 것을 완전히 파괴하려 발버둥 치는 듯했다.%K%P"},{"key":"mac.afs::0134::0163","target_ko":"이윽고…….%K%P"},{"key":"mac.afs::0134::0164","target_ko":"『내 몸』은 기진맥진해 잠들었다.%K%P"},{"key":"mac.afs::0134::0165","target_ko":"우츠미의 품속에서…….%K%P"},{"key":"mac.afs::0134::0166","target_ko":"우츠미는 『내 몸』을 가엾게 여기면서도 사랑스러워하는 듯했다.%K%P"},{"key":"mac.afs::0134::0167","target_ko":"모든 것을 용서하고 받아들이는 여신 같은 포용력과 따스함…….%K%P"},{"key":"mac.afs::0134::0168","target_ko":"영상에서 그런 것들이 느껴졌다.%K%P"},{"key":"mac.afs::0134::0169","target_ko":"『내 몸』은 우츠미의 품속에서 잠들어 있었다.%K%P"},{"key":"mac.afs::0134::0170","target_ko":"평온하게…….%K%P"},{"key":"mac.afs::0134::0171","target_ko":"초봄의 양지에서 졸듯이…….%K%P"},{"key":"mac.afs::0134::0172","target_ko":"조금 전까지 보였던 광기는 흔적도 없이 사라져 있었다.%K%P"}]}