{"translations":[{"key":"mac.afs::0016::0038","target_ko":"둥실둥실…… 둥실둥실…….%K%P"},{"key":"mac.afs::0016::0039","target_ko":"왠지…… 너무나 기분이 좋다.%K%P"},{"key":"mac.afs::0016::0040","target_ko":"마음이 한없이 편안해진다.%K%P"},{"key":"mac.afs::0016::0041","target_ko":"이런 감각은 처음이다.%K%P"},{"key":"mac.afs::0016::0042","target_ko":"이젠 됐어…….%K%P"},{"key":"mac.afs::0016::0043","target_ko":"아무래도 좋아.%K%P"},{"key":"mac.afs::0016::0044","target_ko":"이대로 모든 걸 흘러가는 대로 내버려 두자.%K%P"},{"key":"mac.afs::0016::0045","target_ko":"그때――%K%P"},{"key":"mac.afs::0016::0046","target_ko":"나는 한순간 그것을 엿보았다.%K%P"},{"key":"mac.afs::0016::0047","target_ko":"나를……%K%P"},{"key":"mac.afs::0016::0048","target_ko":"아니……%K%P"},{"key":"mac.afs::0016::0049","target_ko":"정확히는 아마도 『내』가 들어 있던 몸을……%K%P"},{"key":"mac.afs::0016::0050","target_ko":"사토루의 몸을…….%K%P"},{"key":"mac.afs::0016::0051","target_ko":"사토루의 몸은 엎드린 채 뜨거운 물이 담긴 욕조 속에 상반신을 담그고 있었다.%K%P"},{"key":"mac.afs::0016::0052","target_ko":"사토루의 몸은 미동조차 하지 않았다.%K%P"},{"key":"mac.afs::0016::0053","target_ko":"사토루는……%K%P"},{"key":"mac.afs::0016::0054","target_ko":"죽어, 있는 것이다.%K%P"},{"key":"mac.afs::0016::0055","target_ko":"그리고…… 나 역시…….%K%P"},{"key":"mac.afs::0016::0056","target_ko":"그렇구나…….%K%P"},{"key":"mac.afs::0016::0057","target_ko":"나는 모든 것을 이해했다.%K%P"},{"key":"mac.afs::0016::0058","target_ko":"그때…… 어둠에 휩싸인 욕실에서 느꼈던 등 뒤의 인기척.%K%P"},{"key":"mac.afs::0016::0059","target_ko":"그 후 사토루는 누군가에게 살해당한 것이다.%K%P"},{"key":"mac.afs::0016::0060","target_ko":"살해당하고………….%K%P"},{"key":"mac.afs::0016::0061","target_ko":"미안해…….%K%P"},{"key":"mac.afs::0016::0062","target_ko":"미안해, 사토루.%K%P"},{"key":"mac.afs::0016::0063","target_ko":"내가 부주의했던 탓에…… 이런 일이 벌어져 버려서…….%K%P"},{"key":"mac.afs::0016::0064","target_ko":"미안해.%K%P"},{"key":"mac.afs::0016::0065","target_ko":"정말로, 미안해.%K%P"},{"key":"mac.afs::0016::0066","target_ko":"나중에…… 나중에 꼭 사과할 테니까.%K%P"},{"key":"mac.afs::0016::0067","target_ko":"이제 사과하러 갈 테니까.%K%P"},{"key":"mac.afs::0016::0068","target_ko":"그러니까…… 용서해 줘…….%K%P"},{"key":"mac.afs::0016::0069","target_ko":"눈물도 흘리지 않고, 흐느끼지도 않은 채 나는 울었다.%K%P"},{"key":"mac.afs::0016::0070","target_ko":"울고, 울고, 또 울고………….%K%P"},{"key":"mac.afs::0016::0071","target_ko":"마침내……%K%P"},{"key":"mac.afs::0016::0072","target_ko":"나의 세계는 사라졌다.%K%P"},{"key":"mac.afs::0016::0081","target_ko":"잠금 해제――앨범(모든 캐릭터 표정집)"},{"key":"mac.afs::0016::0082","target_ko":"깊고 깊은 구멍의, 가장 깊고 깊은 곳…………………….%K%P"},{"key":"mac.afs::0016::0083","target_ko":"어둡고 어두운 암흑의, 저편 너머의 저편…….%K%P"},{"key":"mac.afs::0016::0084","target_ko":"심연의, 아득히 먼 저편…………………….%K%P"},{"key":"mac.afs::0016::0085","target_ko":"끝없이 끝없이…… 추락하는 듯한.%K%P"},{"key":"mac.afs::0016::0086","target_ko":"그런 상실감.%K%P"},{"key":"mac.afs::0016::0087","target_ko":"아니…… 달라.%K%P"},{"key":"mac.afs::0016::0088","target_ko":"잃은 게 아니라, 애초부터 없었던 것이다.%K%P"},{"key":"mac.afs::0016::0089","target_ko":"아무것도 없다.%K%P"},{"key":"mac.afs::0016::0090","target_ko":"여기에는 아무것도 없다.%K%P"},{"key":"mac.afs::0016::0091","target_ko":"무.%K%P"},{"key":"mac.afs::0016::0092","target_ko":"허무.%K%P"},{"key":"mac.afs::0016::0093","target_ko":"공허할 만큼 아무것도 없다.%K%P"},{"key":"mac.afs::0016::0094","target_ko":"하지만 정말로 아무것도 없다면……%K%P"},{"key":"mac.afs::0016::0095","target_ko":"무를 느끼는 나는 대체 무엇일까?%K%P"},{"key":"mac.afs::0016::0096","target_ko":"나라는 존재는 대체 누구일까?%K%P"},{"key":"mac.afs::0016::0097","target_ko":"무란…… ０을 뜻한다.%K%P"},{"key":"mac.afs::0016::0098","target_ko":"０은 존재하는 것일까?%K%P"},{"key":"mac.afs::0016::0099","target_ko":"존재한다면 ０이란 무엇이지?%K%P"},{"key":"mac.afs::0016::0100","target_ko":"존재하지 않는다면 １은 어디부터 １이지?%K%P"},{"key":"mac.afs::0016::0101","target_ko":"그런 ０과 １의 틈새에서……%K%P"},{"key":"mac.afs::0016::0102","target_ko":"――나는 억지로 끌려 나왔다.%K%P"},{"key":"mac.afs::0016::0103","target_ko":"코코로「　　　　　　아팟！！」%K%P"},{"key":"mac.afs::0016::0104","target_ko":"코코로「　　　　으　　……　　」%K%P"},{"key":"mac.afs::0016::0105","target_ko":"코코로「　　어　　라　　？　　」%K%P"},{"key":"mac.afs::0016::0106","target_ko":"정신을 차렸을 때 나는 책상에 엎드려 있었다.%K%P"},{"key":"mac.afs::0016::0107","target_ko":"그리고 펜을 쥐고 있었다.%K%P"},{"key":"mac.afs::0016::0108","target_ko":"오른손에.%K%P"},{"key":"mac.afs::0016::0109","target_ko":"나도 모르는 사이에 잠들어 버렸던 모양이다.%K%P"},{"key":"mac.afs::0016::0110","target_ko":"꿈조차 꾸지 않을 만큼 깊고 깊은 잠이었다.%K%P"},{"key":"mac.afs::0016::0111","target_ko":"아니, 꿈을 꿨을지도 모른다.%K%P"},{"key":"mac.afs::0016::0112","target_ko":"머릿속이 뿌옇게 흐렸다.%K%P"},{"key":"mac.afs::0016::0113","target_ko":"영문 모를 영상 같은 것이 머릿속에서 빙글빙글 소용돌이치고 있었다.%K%P"},{"key":"mac.afs::0016::0114","target_ko":"그건 잠에서 막 깼을 때의 나른함과는 다른 종류의 몽롱함이었다.%K%P"},{"key":"mac.afs::0016::0115","target_ko":"오히려 막 일어난 것치고는 머릿속이 이상하리만큼 맑았다.%K%P"},{"key":"mac.afs::0016::0116","target_ko":"느껴지는 건 가벼운 피로감 같은 것뿐이고…….%K%P"},{"key":"mac.afs::0016::0117","target_ko":"코코로「으～～～음」%K%P"},{"key":"mac.afs::0016::0118","target_ko":"생각해 봐도 잘 모르겠다.%K%P"},{"key":"mac.afs::0016::0119","target_ko":"아무튼 자고 있다가 이마를 부딪쳐서 깨어났다, 이건가.%K%P"},{"key":"mac.afs::0016::0120","target_ko":"……응？？？%K%P"},{"key":"mac.afs::0016::0121","target_ko":"뭔가, 그거, 이상하지 않아?%K%P"},{"key":"mac.afs::0016::0122","target_ko":"나는 침대에서 자고 있었다.%K%P"},{"key":"mac.afs::0016::0123","target_ko":"책상에 앉은 기억 따윈 없다.%K%P"},{"key":"mac.afs::0016::0124","target_ko":"아니, 오두막에는 책상이 없다.%K%P"},{"key":"mac.afs::0016::0125","target_ko":"아니, 여긴 어디야？？？%K%P"},{"key":"mac.afs::0016::0126","target_ko":"나는 혼란스러워지기 시작한 머리를 진정시키려고 주위를 둘러보며 생각했다.%K%P"},{"key":"mac.afs::0016::0127","target_ko":"방 안에는 침대와 책상과 옷장이 있다.%K%P"},{"key":"mac.afs::0016::0128","target_ko":"모두 아주 단정하고 깨끗해서 쾌적한 인상을 준다.%K%P"},{"key":"mac.afs::0016::0129","target_ko":"하지만 그렇기에 오히려 어딘가 공허하고 텅 빈 『가짜 같은』 분위기도 풍긴다.%K%P"},{"key":"mac.afs::0016::0130","target_ko":"사람의 온기 같은 것을 모조리 빼앗긴 듯한…….%K%P"},{"key":"mac.afs::0016::0131","target_ko":"코코로「아……」%K%P"},{"key":"mac.afs::0016::0132","target_ko":"――이해했다.%K%P"},{"key":"mac.afs::0016::0133","target_ko":"코코로「스피아야」%K%P"},{"key":"mac.afs::0016::0134","target_ko":"손등을 본다.%K%P"},{"key":"mac.afs::0016::0135","target_ko":"익숙한 『후유카와 코코로』의 손과는 다른, 울퉁불퉁하고 커다란 손.%K%P"},{"key":"mac.afs::0016::0136","target_ko":"코코로「또 전이……해 버렸구나」%K%P"},{"key":"mac.afs::0016::0137","target_ko":"한숨과 함께 중얼거렸다.%K%P"},{"key":"mac.afs::0016::0138","target_ko":"갑자기 소변이 마려워졌다.%K%P"},{"key":"mac.afs::0016::0139","target_ko":"일어나 출입구 근처에 있는 욕실 문을 열었다.%K%P"},{"key":"mac.afs::0016::0140","target_ko":"각 방에는 샤워 시설뿐 아니라 화장실도 딸려 있다.%K%P"},{"key":"mac.afs::0016::0141","target_ko":"졸린 눈을 비비며 벨트에 손을 대고……%T30얼어붙었다.%K%P"},{"key":"mac.afs::0016::0142","target_ko":"이 몸은 남자의 몸이다.%K%P"},{"key":"mac.afs::0016::0143","target_ko":"이 몸으로 볼일을 본다는 건, 즉…….%K%P"},{"key":"mac.afs::0016::0144","target_ko":"두려운 마음으로 내려다본다.%K%P"},{"key":"mac.afs::0016::0145","target_ko":"가랑이 사이에서 느껴지는 이질감.%K%P"},{"key":"mac.afs::0016::0146","target_ko":"그러니까,%T30그러니까,%T30그러니까아……%T30그걸,%T30손으로,%T30잡으라고,%T30……?%K%P"},{"key":"mac.afs::0016::0147","target_ko":"어, 어쩔 수 없는 거야.%K%P"},{"key":"mac.afs::0016::0148","target_ko":"그, 그야 지금 내 몸은 남자니까.%K%P"},{"key":"mac.afs::0016::0149","target_ko":"생리 현상을 해결하려는 것뿐이니까.%K%P"},{"key":"mac.afs::0016::0150","target_ko":"이상한 뜻으로 만지는 게 아니니까.%K%P"},{"key":"mac.afs::0016::0151","target_ko":"그 정도는 나도 머리로는 안다.%K%P"},{"key":"mac.afs::0016::0152","target_ko":"알고는 있지만!%K%P"},{"key":"mac.afs::0016::0153","target_ko":"나는 화장실에서 뛰쳐나와 방 한가운데에 엎드렸다.%K%P"},{"key":"mac.afs::0016::0154","target_ko":"코코로「진정해!　진정하는 거야, 나!」%K%P"},{"key":"mac.afs::0016::0155","target_ko":"코코로「심호흡이야!　심호흡하는 거야!」%K%P"},{"key":"mac.afs::0016::0156","target_ko":"코코로「스으스으하아!　스으스으하아!」%K%P"},{"key":"mac.afs::0016::0157","target_ko":"당황한 탓인지 심호흡조차 제대로 되지 않았다.%K%P"},{"key":"mac.afs::0016::0158","target_ko":"코코로「히이히이후우!　히이히이후우!」%K%P"},{"key":"mac.afs::0016::0159","target_ko":"정신을 차리고 보니 어쩐지 순산할 것 같은 호흡으로 바뀌어 버렸다.%K%P"},{"key":"mac.afs::0016::0160","target_ko":"아랫배 부근이 근질거린다.%K%P"},{"key":"mac.afs::0016::0161","target_ko":"맹렬한 요의가 내 배를 압박하고 있다.%K%P"},{"key":"mac.afs::0016::0162","target_ko":"코코로「우아…… 하웃!?」%K%P"},{"key":"mac.afs::0016::0163","target_ko":"큰일이다.%K%P"},{"key":"mac.afs::0016::0164","target_ko":"진짜, 큰일이다.%K%P"},{"key":"mac.afs::0016::0165","target_ko":"코코로「이대로면 어른 실격이 돼 버려어어～～!」%K%P"},{"key":"mac.afs::0016::0166","target_ko":"나는 벌써 ２０살.%T30성인.%T30어른.%K%P"},{"key":"mac.afs::0016::0167","target_ko":"어른으로서.%K%P"},{"key":"mac.afs::0016::0168","target_ko":"아니, 여자애로서.%K%P"},{"key":"mac.afs::0016::0169","target_ko":"아니 아니, 인간으로서 바지를 적실 수는 없다.%K%P"},{"key":"mac.afs::0016::0170","target_ko":"코코로「그래…… 고작 화장실에 가는 것뿐이야……」%K%P"},{"key":"mac.afs::0016::0171","target_ko":"코코로「신경 쓰지 않으면 돼」%K%P"},{"key":"mac.afs::0016::0172","target_ko":"나는 화장실까지 기어갔다.%K%P"},{"key":"mac.afs::0016::0173","target_ko":"혼자서 지금 뭐 하는 거지?　――라는 의문이 문득 들었지만 생각하지 않기로 했다.%K%P"},{"key":"mac.afs::0016::0174","target_ko":"코코로「평소처럼 하면 돼」%K%P"},{"key":"mac.afs::0016::0175","target_ko":"코코로「바지를 내리고 그냥 변기에 앉기만 하면 돼……」%K%P"},{"key":"mac.afs::0016::0176","target_ko":"코코로「아래는 보지 말고……」%K%P"},{"key":"mac.afs::0016::0177","target_ko":"코코로「그것만 하면 되는 거니까」%K%P"},{"key":"mac.afs::0016::0178","target_ko":"코코로「힘내. 힘내, 나!」%K%P"},{"key":"mac.afs::0016::0179","target_ko":"스스로를 응원하며 평소처럼 바지를 내렸다.%K%P"},{"key":"mac.afs::0016::0180","target_ko":"평소 화장실에 갈 때처럼 변기에 걸터앉고――%K%P"},{"key":"mac.afs::0016::0181","target_ko":"나는 다시 화장실에서 뛰쳐나왔다.%K%P"},{"key":"mac.afs::0016::0182","target_ko":"방 한가운데에 엎드렸다.%K%P"},{"key":"mac.afs::0016::0183","target_ko":"코코로「평소 화장실에 갈 때는……」%K%P"},{"key":"mac.afs::0016::0184","target_ko":"코코로「조준하는 과정 같은 건 없단 말이야아!」%K%P"},{"key":"mac.afs::0016::0185","target_ko":"남자가 볼일을 보려면 여자애보다 한 단계 더 필요하다는 걸 알게 된 후유카와 코코로, ２０살의 겨울.%K%P"},{"key":"mac.afs::0016::0186","target_ko":"으아앙…… 그런 건 알고 싶지 않았어!%K%P"},{"key":"mac.afs::0016::0187","target_ko":"코코로「어떻게 해야 하는 거야～!」%K%p"},{"key":"mac.afs::0016::0188","target_ko":"참는다"},{"key":"mac.afs::0016::0189","target_ko":"각오하고 화장실에 간다"},{"key":"mac.afs::0016::0190","target_ko":"역시, 부끄럽기도 하고……%K%P"},{"key":"mac.afs::0016::0191","target_ko":"나는 참기로 했다.%K%P"},{"key":"mac.afs::0016::0192","target_ko":"하지만……%K%P"},{"key":"mac.afs::0016::0193","target_ko":"코코로「와…… 우와와와와왓!」%K%P"},{"key":"mac.afs::0016::0194","target_ko":"요의는 계속 아랫배를 두드리고 있다.%K%P"},{"key":"mac.afs::0016::0195","target_ko":"베토벤이 『운명』을 작곡하기 시작할 것만큼 요란한 노크다.%K%P"},{"key":"mac.afs::0016::0196","target_ko":"코코로「하웃!?　아…… 우아……!?　노아아아아!?」%K%P"},{"key":"mac.afs::0016::0197","target_ko":"식은땀이 줄줄 흘러내린다.%K%P"},{"key":"mac.afs::0016::0198","target_ko":"큰일이야!　너무 큰일이야!%K%P"},{"key":"mac.afs::0016::0199","target_ko":"코코로「어떡하지……?」%K%p"},{"key":"mac.afs::0016::0200","target_ko":"그래도 참는다"},{"key":"mac.afs::0016::0201","target_ko":"각오하고 화장실에 간다"},{"key":"mac.afs::0016::0202","target_ko":"극심한 안짱걸음으로 침대까지 다가가 머리에 베개를 뒤집어쓰고 화장실을 잊으려 했다.%K%P"},{"key":"mac.afs::0016::0203","target_ko":"코코로「뭔가 다른 걸 생각하면 돼……」%K%P"},{"key":"mac.afs::0016::0204","target_ko":"일단 내가 어려워하는 철학 수업을 떠올려 보자.%K%P"},{"key":"mac.afs::0016::0205","target_ko":"코코로「그게…… 도덕 형이상학을 통해 칸트는 『내 위의 별이 빛나는 하늘과 내 안의 도덕 법칙』에……」%K%P"},{"key":"mac.afs::0016::0206","target_ko":"코코로「――하우앗!?」%K%P"},{"key":"mac.afs::0016::0207","target_ko":"내 사고는 금세 끊겼다.%K%P"},{"key":"mac.afs::0016::0208","target_ko":"바닥을 데굴데굴 구르며 밀려오는 거대한 해일에 맞선다.%K%P"},{"key":"mac.afs::0016::0209","target_ko":"코코로「우아…… 하냐…… 위…험해……」%K%p"},{"key":"mac.afs::0016::0210","target_ko":"차…… 참는 거야……"},{"key":"mac.afs::0016::0211","target_ko":"각오하고 화장실에 간다"},{"key":"mac.afs::0016::0212","target_ko":"코코로「그래도… 차… 참는 거야……」%K%P"},{"key":"mac.afs::0016::0213","target_ko":"코코로「우냣… 하왓… 우와왓…!」%K%P"},{"key":"mac.afs::0016::0214","target_ko":"코코로「탓…… 핫…… 후왓……」%K%P"},{"key":"mac.afs::0016::0215","target_ko":"코코로「아니, 역시 무리야――앗!」%K%P"},{"key":"mac.afs::0016::0216","target_ko":"코코로「하우앗!　한계야아!」%K%P"},{"key":"mac.afs::0016::0217","target_ko":"나는 몸부림치듯 다시 화장실로 향했다.%K%P"},{"key":"mac.afs::0016::0218","target_ko":"이런 꼴을 보이면 시집도 못 갈 것 같지만 생각하지 않기로 했다.%K%P"},{"key":"mac.afs::0016::0219","target_ko":"생각하면 아마 울어 버릴 테니까.%K%P"},{"key":"mac.afs::0016::0220","target_ko":"나는 각오를 굳히고 변기에 걸터앉았다――%K%P"},{"key":"mac.afs::0016::0221","target_ko":"코코로「피…… 피곤해……」%K%P"},{"key":"mac.afs::0016::0222","target_ko":"기진맥진한 채 침대에 털썩 주저앉았다.%K%P"},{"key":"mac.afs::0016::0223","target_ko":"볼일을 보는 데 이토록 지친 건 태어나서 처음이었다.%K%P"},{"key":"mac.afs::0016::0224","target_ko":"만약 이 인격 교환이 앞으로도 계속된다면 익숙해져야겠지만……%K%P"},{"key":"mac.afs::0016::0225","target_ko":"꽃다운 처녀인 나에게는 자극이 너무 강하다!%K%P"},{"key":"mac.afs::0016::0226","target_ko":"그리 쉽게 익숙해질 수 있을 것 같지는 않다.%K%P"},{"key":"mac.afs::0016::0227","target_ko":"코코로「그렇다는 건…… 잠깐만!」%K%P"},{"key":"mac.afs::0016::0228","target_ko":"끔찍한 사실을 깨달았다.%K%P"},{"key":"mac.afs::0016::0229","target_ko":"지금 대피 오두막에 있는 내 몸에는 내가 들어간 이 몸의 주인――유키도 사토루의 인격이 깃들어 있을지도 모른다는 뜻이다!%K%P"},{"key":"mac.afs::0016::0230","target_ko":"즉, 그는 내 몸을 마음대로 다룰 수 있다…….%K%P"},{"key":"mac.afs::0016::0231","target_ko":"생면부지의 남자에게 내 몸을 농락당하는 기분이 들어 온몸에 소름이 돋았다.%K%P"},{"key":"mac.afs::0016::0232","target_ko":"코코로「시…… 싫어……」%K%P"},{"key":"mac.afs::0016::0233","target_ko":"나도 모르게 신음이 흘러나왔다.%K%P"},{"key":"mac.afs::0016::0234","target_ko":"답답한 나머지 우리 안의 동물처럼 방을 서성거렸다.%K%P"},{"key":"mac.afs::0016::0235","target_ko":"가만히 있을 수가 없었다.%K%P"},{"key":"mac.afs::0016::0236","target_ko":"그때 테이블 위에 메모가 놓여 있는 것을 발견했다.%K%P"},{"key":"mac.afs::0016::0237","target_ko":"지푸라기라도 잡는 심정으로 집어 들었다.%K%P"},{"key":"mac.afs::0016::0238","target_ko":"머릿속의 몽롱함은 좀처럼 사라지지 않는다.%K%P"},{"key":"mac.afs::0016::0239","target_ko":"세수라도 하고 오자…….%K%P"},{"key":"mac.afs::0016::0240","target_ko":"일어나 출입구 근처에 있는 욕실 문을 열었다.%K%P"},{"key":"mac.afs::0016::0241","target_ko":"찬물을 몇 번 얼굴에 끼얹자 머릿속이 차츰 맑아졌다.%K%P"},{"key":"mac.afs::0016::0242","target_ko":"영문 모를 몽롱함도 사라졌다.%K%P"},{"key":"mac.afs::0016::0243","target_ko":"코코로「후우～」%K%P"},{"key":"mac.afs::0016::0244","target_ko":"고개를 들자 거울에 『그』가 비쳐 있었다.%K%P"},{"key":"mac.afs::0016::0245","target_ko":"그――유키도 사토루.%K%P"}]}