afs::0033::0013","target_ko":"아침 뉴스에서 오늘의 운세 순위를 하면 나도 모르게 보게 된다.%K%P"},{"key":"mac.afs::0033::0014","target_ko":"여자애란 다 그런 법이다.%K%P"},{"key":"mac.afs::0033::0015","target_ko":"하지만 사토루는 점과는 인연이 없는 유형이라고 생각했다.%K%P"},{"key":"mac.afs::0033::0016","target_ko":"분명 『과학적 근거가 어디 있어!』라며 따질 것 같은 느낌.%K%P"},{"key":"mac.afs::0033::0017","target_ko":"그래서 조금 의외였다.%K%P"},{"key":"mac.afs::0033::0018","target_ko":"유니는 내 얼굴을 빤히 들여다본다.%K%P"},{"key":"mac.afs::0033::0019","target_ko":"유니「혹시……코코롱으로 돌아왔어?」%K%P"},{"key":"mac.afs::0033::0020","target_ko":"코코로「응」%K%P"},{"key":"mac.afs::0033::0021","target_ko":"유니는 눈을 동그랗게 뜨고 계속 내 표정을 살폈지만,%K%P"},{"key":"mac.afs::0033::0022","target_ko":"유니「그렇구나……있잖아! 점 계속 봐도 돼?」%K%P"},{"key":"mac.afs::0033::0023","target_ko":"유니「도중에 그만두면 찝찝하잖아」%K%P"},{"key":"mac.afs::0033::0024","target_ko":"코코로「글쎄……」%K%P"},{"key":"mac.afs::0033::0025","target_ko":"코코로「아, 잠깐만」%K%P"},{"key":"mac.afs::0033::0026","target_ko":"그 전에 시간을 확인해야 해……%K%P"},{"key":"mac.afs::0033::0027","target_ko":"――그런데 역시 손목시계가 없어!%K%P"},{"key":"mac.afs::0033::0028","target_ko":"또다시 내 오른팔에서 손목시계가 풀려 있었다.%K%P"},{"key":"mac.afs::0033::0029","target_ko":"어디야? 이번에는 어디에 둔 거야??%K%P"},{"key":"mac.afs::0033::0030","target_ko":"주머니를 뒤진다.%K%P"},{"key":"mac.afs::0033::0031","target_ko":"――없다.%K%P"},{"key":"mac.afs::0033::0032","target_ko":"이층 침대의 사다리.%K%P"},{"key":"mac.afs::0033::0033","target_ko":"――없다.%K%P"},{"key":"mac.afs::0033::0034","target_ko":"고개를 돌려 주위를 둘러본다.%K%P"},{"key":"mac.afs::0033::0035","target_ko":"――찾았다.%K%P"},{"key":"mac.afs::0033::0036","target_ko":"의자 위에 놓인 테디베어 인형.%K%P"},{"key":"mac.afs::0033::0037","target_ko":"손목시계는 인형 목에 감겨 있었다.%K%P"},{"key":"mac.afs::0033::0038","target_ko":"풀어서 손목에 찬다.%K%P"},{"key":"mac.afs::0033::0039","target_ko":"이 망할 자식! 다음에는 꼭 따지고 말겠어!%K%P"},{"key":"mac.afs::0033::0040","target_ko":"시각은 2시 28분이었다.%K%P"},{"key":"mac.afs::0033::0041","target_ko":"유니「저기이~? 코코로옹?」%K%P"}]}